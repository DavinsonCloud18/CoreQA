generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// MASTER DATA & AUTH
// =======================

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // e.g., "Super Admin", "Leader", "QA Member"
  users User[]

  @@map("roles")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  password         String
  name             String
  roleId           Int
  role             Role               @relation(fields: [roleId], references: [id])
  isActive         Boolean            @default(true)
  executions       SessionExecution[]
  claimHistories   ClaimHistory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([roleId])
  @@map("users")
}

model Environment {
  id          Int       @id @default(autoincrement())
  name        String    @unique // e.g., "SIT", "UAT", "PROD"
  description String?
  sessions    Session[]

  @@map("environments")
}

model Status {
  id          Int                @id @default(autoincrement())
  name        String             @unique // e.g., "PASSED", "FAILED", "PASSED WITH NOTES", "UNTESTED"
  executions  SessionExecution[]

  @@map("statuses")
}

// =======================
// TESTCASE STRUCTURE
// =======================

model Module {
  id             String           @id @default(uuid())
  name           String
  description    String?
  testcases      MasterTestcase[]
  sessionModules SessionModule[]
  claimHistories ClaimHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("modules")
}

model MasterTestcase {
  id             String             @id @default(uuid())
  moduleId       String
  module         Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  expectedResult String?
  sequence       Int                @default(0)
  executions     SessionExecution[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([moduleId])
  @@map("master_testcases")
}

// =======================
// EXECUTION & CLAIMING
// =======================

model Session {
  id             String             @id @default(uuid())
  name           String
  environmentId  Int
  environment    Environment        @relation(fields: [environmentId], references: [id])
  isOpen         Boolean            @default(true) 
  startDate      DateTime           @default(now())
  endDate        DateTime?
  sessionModules SessionModule[]
  executions     SessionExecution[]
  claimHistories ClaimHistory[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([environmentId])
  @@index([isOpen])
  @@map("sessions")
}

model SessionModule {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([sessionId, moduleId]) 
  @@index([sessionId])
  @@index([moduleId])
  @@map("session_modules")
}

model SessionExecution {
  id           String         @id @default(uuid())
  sessionId    String
  session      Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testcaseId   String
  testcase     MasterTestcase @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  statusId     Int
  status       Status         @relation(fields: [statusId], references: [id])
  executedById String?
  executedBy   User?          @relation(fields: [executedById], references: [id])
  notes        String?        
  executedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([sessionId, testcaseId]) 
  @@index([sessionId])
  @@index([testcaseId])
  @@index([statusId])
  @@index([executedById])
  @@map("session_executions")
}

model ClaimHistory {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  claimedById String
  claimedBy   User     @relation(fields: [claimedById], references: [id])
  isActive    Boolean  @default(true)
  claimedAt   DateTime @default(now())

  @@index([sessionId])
  @@index([moduleId])
  @@index([claimedById])
  @@index([sessionId, moduleId, isActive]) 
  @@map("claim_histories")
}
