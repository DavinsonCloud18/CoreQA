generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// MASTER DATA & AUTH
// =======================

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // e.g., "Super Admin", "Leader", "QA Member"
  users User[]

  @@map("roles")
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  password         String
  name             String
  roleId           Int
  role             Role               @relation(fields: [roleId], references: [id])
  isActive         Boolean                @default(true)
  executions       SessionExecution[]
  claimHistories   ClaimHistory[]
  createdTestcases MasterTestcase[]       @relation("TestcaseCreator")
  updatedTestcases MasterTestcase[]       @relation("TestcaseUpdater")
  notifications    TestcaseNotification[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  isDeleted        Boolean                @default(false)
  deletedAt        DateTime?

  @@index([roleId])
  @@map("users")
}

model Environment {
  id          Int       @id @default(autoincrement())
  name        String    @unique // e.g., "SIT", "UAT", "PROD"
  description String?
  sessions    Session[]

  @@map("environments")
}

model Status {
  id          Int                @id @default(autoincrement())
  name                String                 @unique // e.g., "PASSED", "FAILED", "PASSED WITH NOTES", "UNTESTED"
  executions          SessionExecution[]
  stepExecutions      SessionStepExecution[]

  @@map("statuses")
}

// =======================
// TESTCASE STRUCTURE
// =======================

model Module {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  description    String?
  testcaseCount  Int              @default(0)
  testcases      MasterTestcase[]
  sessionModules SessionModule[]
  claimHistories ClaimHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  isDeleted      Boolean          @default(false)
  deletedAt      DateTime?

  @@map("modules")
}

model MasterTestcase {
  id             String                 @id @default(uuid())
  testcaseId     String                 @unique
  moduleId       String
  module         Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  precondition   String?
  expectedResult String?
  sequence       Int                    @default(0)
  priority       String                 @default("sedang")
  severity       String                 @default("minor")
  
  createdById    String?
  createdBy      User?                  @relation("TestcaseCreator", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?                  @relation("TestcaseUpdater", fields: [updatedById], references: [id])
  
  isDeleted      Boolean                @default(false)
  deletedAt      DateTime?

  steps          TestcaseStep[]
  executions     SessionExecution[]
  notifications  TestcaseNotification[]
  
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([moduleId])
  @@index([createdById])
  @@map("master_testcases")
}

model TestcaseStep {
  id             String         @id @default(uuid())
  testcaseId     String
  testcase       MasterTestcase @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  sequence       Int
  action         String
  expectedResult String
  sessionExecutions SessionStepExecution[]

  @@index([testcaseId])
  @@map("testcase_steps")
}

// =======================
// EXECUTION & CLAIMING
// =======================

model Session {
  id             String             @id @default(uuid())
  name           String
  environmentId  Int
  environment    Environment        @relation(fields: [environmentId], references: [id])
  isOpen         Boolean            @default(true) 
  status         String             @default("TO DO") // e.g. "TO DO", "On Progress", "Finished"
  startDate      DateTime           @default(now())
  endDate        DateTime?
  sessionModules SessionModule[]
  executions     SessionExecution[]
  claimHistories ClaimHistory[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  isDeleted      Boolean            @default(false)
  deletedAt      DateTime?

  @@index([environmentId])
  @@index([isOpen])
  @@index([status])
  @@map("sessions")
}

model SessionModule {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([sessionId, moduleId]) 
  @@index([sessionId])
  @@index([moduleId])
  @@map("session_modules")
}

model SessionExecution {
  id           String         @id @default(uuid())
  sessionId    String
  session      Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testcaseId   String
  testcase     MasterTestcase @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  statusId     Int
  status       Status         @relation(fields: [statusId], references: [id])
  executedById String?
  executedBy   User?          @relation(fields: [executedById], references: [id])
  notes        String?        
  executedAt   DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  stepExecutions SessionStepExecution[]

  @@unique([sessionId, testcaseId]) 
  @@index([sessionId])
  @@index([testcaseId])
  @@index([statusId])
  @@index([executedById])
  @@map("session_executions")
}

model ClaimHistory {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  claimedById String
  claimedBy   User     @relation(fields: [claimedById], references: [id])
  isActive    Boolean  @default(true)
  claimedAt   DateTime @default(now())

  @@index([sessionId])
  @@index([moduleId])
  @@index([claimedById])
  @@index([sessionId, moduleId, isActive]) 
  @@map("claim_histories")
}

model SessionStepExecution {
  id                 String           @id @default(uuid())
  sessionExecutionId String
  sessionExecution   SessionExecution @relation(fields: [sessionExecutionId], references: [id], onDelete: Cascade)
  stepId             String
  step               TestcaseStep     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  statusId           Int
  status             Status           @relation(fields: [statusId], references: [id])
  notes              String?
  updatedAt          DateTime         @updatedAt

  @@unique([sessionExecutionId, stepId])
  @@index([sessionExecutionId])
  @@index([stepId])
  @@index([statusId])
  @@map("session_step_executions")
}

model TestcaseNotification {
  id          String         @id @default(uuid())
  testcaseId  String
  testcase    MasterTestcase @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  userId      String         
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  isRead      Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([testcaseId])
  @@map("testcase_notifications")
}
